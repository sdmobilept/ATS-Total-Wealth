# Copy to .env.local and fill in. Never commit .env.local.

# RentCast API key (https://app.rentcast.io/app/api). Leave empty to disable automatic home values.
RENTCAST_API_KEY=

# Hard cap on RentCast requests per billing period. RentCast bills $0.20 per request beyond
# the free plan's 50 and has no cap of its own, so this counter is what prevents charges.
RENTCAST_MONTHLY_LIMIT=50

# Day of month your RentCast billing period renews (1-28). See your RentCast billing page.
RENTCAST_BILLING_DAY=1
